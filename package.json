{
  "name": "fittrack",
  "version": "1.0.0",
  "private": true,
  "description": "Calorie, macro and body-weight tracker that runs from a single file",
  "scripts": {
    "sync:www": "node scripts/build-www.mjs",
    "sync": "npm run sync:www && cap sync",
    "add:ios": "npm run sync:www && cap add ios",
    "add:android": "npm run sync:www && cap add android",
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "capacitor-health": "^8.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "^1.63.0"
  }
}
